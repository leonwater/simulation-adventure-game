{
  "name": "adventurer-web",
  "private": true,
  "version": "3.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run && vite build",
    "shot": "node scripts/shot.mjs",
    "fx": "node scripts/fxdemo.mjs",
    "cap:sync": "npm run build && cap sync android",
    "balance": "rolldown src/sim/cli.ts --file .sim/balance.mjs --format esm --platform node && node .sim/balance.mjs",
    "flow": "node scripts/flow.mjs",
    "e2e": "node scripts/e2e.mjs",
    "monkey": "node scripts/monkey.mjs",
    "systems": "node scripts/systems.mjs",
    "gear": "rolldown src/sim/gearcli.ts --file .sim/gear.mjs --format esm --platform node && node .sim/gear.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3"
  }
}
